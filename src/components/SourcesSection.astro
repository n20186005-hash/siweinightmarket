---
import { editorialSources } from '../data/sources';

interface Props {
  heading?: string;
}

const { heading = '資料來源與同步時間' } = Astro.props;
---

<section id="sources" class="section-space bg-white">
  <div class="container-site">
    <div class="max-w-3xl">
      <p class="eyebrow">SOURCES & E-E-A-T</p>
      <h2 class="serif-tc mt-3 text-4xl font-black text-night-950 sm:text-5xl">{heading}</h2>
      <p class="mt-5 leading-8 text-slate-600">本站為獨立旅遊資訊網站，重要資訊皆標註來源與同步時間。引用之 Google 地圖評價僅於頁面呈現，版權歸原作者與 Google 地圖所有。</p>
    </div>

    <ul class="mt-10 grid gap-4 md:grid-cols-2">
      {editorialSources.map((item) => (
        <li class="rounded-3xl border border-night-900/8 bg-rice-50 p-6">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-lg font-black text-night-950">{item.topic}</h3>
            <span class="rounded-full bg-white px-2.5 py-1 text-xs font-bold text-market-600">同步時間 {item.checkedAt}</span>
          </div>
          <p class="mt-3 text-sm leading-7 text-slate-600">來源：{item.source}</p>
          {'note' in item && item.note && <p class="mt-2 text-xs leading-6 text-slate-500">{item.note}</p>}
          {'url' in item && item.url && (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-1.5 text-sm font-black text-market-600 hover:text-market-500" data-ga-event="sources_outbound">
              {'linkText' in item && item.linkText ? item.linkText : '查看來源'}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
