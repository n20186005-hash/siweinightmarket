---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
const touristMap = 'https://www.google.com/maps/search/?api=1&query=%E8%87%BA%E6%9D%B1%E8%A7%80%E5%85%89%E5%A4%9C%E5%B8%82%20%E6%AD%A3%E6%B0%A3%E8%B7%AF';
const official = 'https://tour.taitung.gov.tw/zh-tw/Tour/Details/68';
const cityNotice = 'https://www.taitungcity.gov.tw/news/%E5%85%AC%E5%91%8A%E8%87%BA%E6%9D%B1%E7%B8%A3%E8%87%BA%E6%9D%B1%E5%B8%82%E8%A7%80%E5%85%89%E5%A4%9C%E5%B8%82%E4%BF%83%E9%80%B2%E6%9C%83%E7%94%B3%E8%A8%AD%E6%94%A4%E8%B2%A9%E8%87%A8%E6%99%82%E9%9B%86%E4%B8%AD%E5%8D%80';
const faq = [
  ['台東觀光夜市和四維夜市一樣嗎？', '不是。臺東觀光夜市主要位於正氣路，例行營業日為週四至週六；四維夜市以週日為主，現有攤區資訊指向四維路底一帶。'],
  ['星期日去台東哪個夜市？', '可優先查詢四維夜市當週公告；正氣路觀光夜市的例行營業日並不是週日。'],
  ['週四至週六晚上要逛哪個？', '可查詢正氣路的臺東觀光夜市。遇節慶、暑假或臨時活動時，請以主管機關及現場公告為準。']
];
const jsonLd = { '@context':'https://schema.org', '@graph': [
  { '@type': 'WebPage', url: `${site.url}/taitung-night-markets/`, name: '台東夜市比較｜四維夜市與臺東觀光夜市營業日、位置及選擇', inLanguage: 'zh-Hant-TW' },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: '首頁', item: site.url }, { '@type': 'ListItem', position: 2, name: '台東夜市比較', item: `${site.url}/taitung-night-markets/` }] },
  { '@type': 'FAQPage', mainEntity: faq.map(([name, answer]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text: answer } })) }
] };
---
<BaseLayout title="台東夜市比較｜四維夜市 vs 臺東觀光夜市：星期幾開、在哪裡、怎麼選" description="台東夜市怎麼選？比較週日四維夜市與週四至週六正氣路臺東觀光夜市的地點、營業日、交通及逛街特色，附分別導航與官方資料。">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="bg-night-950 py-16 text-white sm:py-20"><div class="container-site max-w-5xl"><Breadcrumbs dark items={[{ label: '台東夜市比較' }]} /><p class="mt-10 text-xs font-black tracking-[.18em] text-lantern-300">TAITUNG NIGHT MARKETS</p><h1 class="serif-tc mt-3 text-4xl font-black leading-tight sm:text-6xl">台東夜市怎麼選？<br />四維與正氣路一次看懂</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-white/70">兩個夜市有不同營業日與位置。先看你哪天到台東，再決定去哪一個，避免導航錯誤或遇到沒有開市的日子。</p></div></section>
  <section class="section-space bg-rice-50"><div class="container-site"><h2 class="serif-tc text-3xl font-black text-night-950">兩個夜市快速比較</h2><div class="mt-7 overflow-x-auto rounded-3xl bg-white shadow-sm"><table class="w-full min-w-[620px] text-left"><thead class="bg-night-950 text-white"><tr><th class="p-5">比較項目</th><th class="p-5">四維夜市</th><th class="p-5">臺東觀光夜市</th></tr></thead><tbody class="divide-y divide-slate-100"><tr><th class="p-5">例行營業日</th><td class="p-5 font-black">週日</td><td class="p-5 font-black">週四、週五、週六</td></tr><tr><th class="p-5">位置</th><td class="p-5">四維路底、海濱公園周邊（暫遷攤區資訊）</td><td class="p-5">臺東市正氣路一帶</td></tr><tr><th class="p-5">適合安排</th><td class="p-5">週日晚餐、家庭遊戲、海岸散步後順遊</td><td class="p-5">週四至週六市中心晚餐、正氣路街區散步</td></tr><tr><th class="p-5">交通重點</th><td class="p-5">先核對臨時攤區、停車與回程</td><td class="p-5">注意市區道路夜間攤區和交通管制</td></tr><tr><th class="p-5">地圖</th><td class="p-5"><a class="font-black text-market-600 underline" href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer">四維夜市地點</a></td><td class="p-5"><a class="font-black text-market-600 underline" href={touristMap} target="_blank" rel="noopener noreferrer">正氣路夜市地點搜尋</a></td></tr></tbody></table></div><p class="mt-5 text-sm leading-7 text-slate-600">這裡列的是例行安排，不是即時開市狀態。正氣路夜市歷年有暑期加開日的公告，特殊活動、天候及交通管制應以當週最新資訊為準。</p></div></section>
  <section class="section-space bg-white"><div class="container-site grid gap-7 lg:grid-cols-2"><article class="overflow-hidden rounded-3xl border border-slate-200"><img src="/images/siwei-night-market-food.webp" alt="四維夜市美食攤位的既有實景照片" width="1200" height="800" class="aspect-[16/9] w-full object-cover" loading="lazy" /><div class="p-7"><h2 class="text-2xl font-black">週日：選四維夜市</h2><p class="mt-4 leading-8 text-slate-600">若週日下午在臺東市區，可以先走訪<a href="/attractions/taitung-forest-park/" class="text-market-600 underline">臺東森林公園</a>或<a href="/attractions/taitung-seaside-park/" class="text-market-600 underline">海濱公園</a>，傍晚再確認四維夜市出攤。這個夜市有小吃與親子遊戲，攤商不保證每週固定出現。</p><div class="mt-5 flex flex-wrap gap-4"><a href="/food/" class="font-black text-market-600 underline">必吃美食選擇 →</a><a href="/relocation/" class="font-black text-market-600 underline">搬遷導航核對 →</a></div></div></article><article class="overflow-hidden rounded-3xl border border-slate-200"><div class="flex aspect-[16/9] items-center justify-center bg-night-900 p-8 text-center text-white"><div><p class="text-xs font-black tracking-[.18em] text-lantern-300">ZHENGQI ROAD</p><p class="serif-tc mt-3 text-3xl font-black">正氣路・臺東觀光夜市</p><p class="mt-3 text-white/60">週四至週六市中心夜市</p></div></div><div class="p-7"><h2 class="text-2xl font-black">週四至週六：選臺東觀光夜市</h2><p class="mt-4 leading-8 text-slate-600">正氣路夜市位於臺東市中心，旅遊主管機關將它列為週四至週六的夜間去處；適合在市區用餐、逛街。此處不使用四維夜市照片冒充正氣路現場，出發前請核對<a class="text-market-600 underline" href={official} target="_blank" rel="noopener noreferrer">官方旅遊介紹</a>。</p><a href={touristMap} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block font-black text-market-600 underline">正氣路獨立地圖搜尋 →</a></div></article></div></section>
  <section class="section-space bg-rice-100"><div class="container-site max-w-5xl"><h2 class="serif-tc text-3xl font-black text-night-950">常見問題</h2><div class="mt-6 space-y-4">{faq.map(([q,a]) => <details class="rounded-2xl bg-white p-6"><summary class="cursor-pointer font-black">{q}</summary><p class="mt-3 leading-7 text-slate-600">{a}</p></details>)}</div><h2 class="mt-12 text-xl font-black">資料依據與查詢</h2><ul class="mt-4 list-disc space-y-2 pl-5 leading-7 text-slate-600"><li><a href={official} target="_blank" rel="noopener noreferrer" class="text-market-600 underline">臺東縣政府觀光旅遊網：臺東市郊行程及正氣路夜市</a></li><li><a href={cityNotice} target="_blank" rel="noopener noreferrer" class="text-market-600 underline">臺東市公所：正氣路觀光夜市攤販集中區公告</a></li><li><a href={site.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="text-market-600 underline">Google 地圖：四維夜市</a></li></ul><p class="mt-3 text-sm text-slate-500">資料查閱：2026 年 11 月 18 日；不代表已現場確認當日開市。</p></div></section>
</BaseLayout>
