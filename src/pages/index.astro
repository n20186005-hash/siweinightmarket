  <script is:inline>
    (() => {
      const status = document.getElementById('market-status');
      const note = document.getElementById('market-status-note');
      const timeEl = document.getElementById('taiwan-time');
      const countdownEl = document.getElementById('sunday-countdown');
      if (!status || !note || !timeEl) return;
      const parts = new Intl.DateTimeFormat('zh-TW', {
        timeZone: 'Asia/Taipei', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
      }).formatToParts(new Date());
      const get = (type) => parts.find((p) => p.type === type)?.value || '';
      const weekday = get('weekday');
      const hour = Number(get('hour'));
      const minute = get('minute');
      const isSunday = weekday.includes('日');
      if (isSunday && hour >= 18 && hour < 23) {
        status.textContent = '今晚可能正在營業';
        note.textContent = '目前落在週日常見營業時段，實際仍以現場與當週公告為準。';
      } else if (isSunday && hour < 18) {
        status.textContent = '今天是例行營業日';
        note.textContent = '建議傍晚 18:00 左右抵達，先確認天候與當週公告。';
      } else if (isSunday) {
        status.textContent = '今晚多數攤位可能已收攤';
        note.textContent = '不同攤位收攤時間不一，晚到不保證仍有完整攤位。';
      } else {
        status.textContent = '下一個例行營業日：週日';
        note.textContent = '四維夜市不是每日營業，安排行程時請先確認星期。';
      }
      timeEl.textContent = `台灣時間：${weekday} ${String(hour).padStart(2, '0')}:${minute}`;
      if (countdownEl) {
        const dayIdx = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Taipei' })).getDay();
        if (dayIdx === 0) {
          countdownEl.textContent =
            hour >= 18 && hour < 23 ? '今天就是營業日（週日），目前落在常見時段內' : '今天就是營業日（週日）';
        } else {
          countdownEl.textContent = `距離下一個營業日（週日）還有 ${7 - dayIdx} 天`;
        }
      }
    })();
  </script>
</BaseLayout>
