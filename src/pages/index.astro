---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import SourcesSection from '../components/SourcesSection.astro';
import WeatherModule from '../components/WeatherModule.astro';
import { site, foods, faqs, visitFacts, visitSteps, transportTips, routePlans, nearbyLandmarks, googleRating, openingHours } from '../data/site';
import { visitorServices, seasonPlan, audienceRoutes, itineraries, visitorResponsibility } from '../data/guide';

const heroImage = `${site.url}/images/siwei-night-market-hero.webp`;
const ogImage = `${site.url}/og.jpg`;
const heroStars = Array.from({ length: 5 }, (_, i) => i < Math.round(googleRating.ratingValue));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: '四維夜市',
      inLanguage: 'zh-Hant-TW'
    },
    {
      '@type': 'WebPage',
      '@id': `${site.url}/#webpage`,
      url: site.url,
      name: site.seoTitle,
      description: site.description,
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': `${site.url}/#attraction` },
      primaryImageOfPage: { '@id': `${site.url}/#primaryimage` }
    },
    {
      '@type': 'ImageObject',
      '@id': `${site.url}/#primaryimage`,
      url: heroImage,
      width: 1290,
      height: 860,
      caption: '四維夜市搬遷前場地的夜間實景紀錄'
    },
    {
      '@type': ['TouristAttraction', 'LocalBusiness'],
      '@id': `${site.url}/#attraction`,
      name: site.fullName,
      alternateName: [site.shortName, '臺東四維夜市', '四維路夜市', 'Siwei Night Market'],
      description: `${site.fullName}（${site.shortName}）位於${site.country}${site.state}${site.city}，是每週日限定的在地型露天夜市，包含小吃、遊戲與生活雜貨攤位。`,
      url: site.url,
      isAccessibleForFree: true,
      image: [ogImage, heroImage],
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.streetAddress,
        addressLocality: site.city,
        addressRegion: site.state,
        postalCode: site.postalCode,
        addressCountry: site.countryCode
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.latitude,
        longitude: site.longitude
      },
      hasMap: site.mapsShareUrl,
      sameAs: [site.mapsShareUrl, site.govtTourismUrl],
      // 每週日例行時段。露天流動夜市實際開收仍受天候與當週公告影響。
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: openingHours.dayOfWeek,
          opens: openingHours.opens,
          closes: openingHours.closes
        }
      ]
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: site.url }
      ]
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(([question, answer]) => ({
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: answer }
      }))
    }
  ]
};
---
<BaseLayout
  title={site.seoTitle}
  description={site.description}
  imageAlt={`${site.fullName}－${site.state}${site.city}四維路底的週日夜市`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="relative isolate min-h-[78svh] overflow-hidden bg-night-950 text-white">
    <img src="/images/siwei-night-market-hero.webp" alt="台東四維夜市舊場地夜間攤位與人潮實景" width="1290" height="860" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover object-center" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,17,31,.94)_0%,rgba(7,17,31,.72)_46%,rgba(7,17,31,.22)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-night-950 to-transparent"></div>
    <div class="container-site relative flex min-h-[78svh] items-center py-20">
      <div class="max-w-3xl">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-lantern-300/40 bg-night-950/45 px-4 py-2 text-sm font-bold text-lantern-300 backdrop-blur">
          <span class="size-2 animate-pulse rounded-full bg-lantern-400"></span>
          台東・每週日限定
        </div>
        <h1 class="serif-tc text-5xl font-black tracking-tight sm:text-6xl lg:text-8xl">臺東市四維夜市<span class="mt-3 block text-2xl font-black tracking-normal text-lantern-300 sm:text-3xl">台東四維夜市・每週日限定</span></h1>
        <p class="mt-6 max-w-2xl text-lg font-medium leading-8 text-white/85 sm:text-xl">只有星期日，才看得到的台東夜生活。從在地小吃、鐵板牛排到親子遊戲，一個晚上感受最日常的台東。</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.mapUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-lantern-400 px-6 py-3.5 font-black text-night-950 transition hover:-translate-y-0.5 hover:bg-lantern-300" data-ga-event="map_hero">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2"><path d="M12 21s6-5.4 6-12A6 6 0 0 0 6 9c0 6.6 6 12 6 12Z"/><circle cx="12" cy="9" r="2"/></svg>
            導航到目前位置
          </a>
          <a href="/transport/" class="rounded-full border border-white/35 bg-white/10 px-6 py-3.5 font-bold backdrop-blur transition hover:bg-white/20">先看交通停車</a>
        </div>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href={googleRating.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-4 py-2 text-sm font-bold backdrop-blur transition hover:bg-white/20" data-ga-event="rating_hero">
            <span class="flex items-center gap-0.5" aria-hidden="true">
              {heroStars.map((filled) => (
                <svg viewBox="0 0 24 24" class:list={['size-4', filled ? 'fill-lantern-400' : 'fill-white/25']}><path d="M12 2.5l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.35 6.2 20.4l1.1-6.45-4.7-4.6 6.5-.95L12 2.5Z" /></svg>
              ))}
            </span>
            <span>Google 地圖 <strong class="text-lantern-300">{googleRating.ratingText}</strong> 分・{googleRating.reviewCountText} 則評價</span>
          </a>
        </div>
        <p class="mt-3 text-xs text-white/55">
          {googleRating.inlineNote}<a href={googleRating.url} target="_blank" rel="noopener noreferrer" class="font-bold text-lantern-300 underline decoration-lantern-300/40 underline-offset-2 hover:text-lantern-400">{googleRating.inlineLinkText}</a>
        </p>
        <p class="mt-5 text-xs text-white/55">首圖為四維夜市搬遷前場地實景；前往夜市請依本頁目前位置導航。</p>
      </div>
    </div>
    <div class="container-site relative -mb-1 grid gap-px overflow-hidden rounded-t-3xl bg-white/10 grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
      {visitFacts.map(({ label, value }) => (
        <div class="bg-night-900/90 px-6 py-5 backdrop-blur">
          <span class="block text-xs tracking-[.16em] text-lantern-300">{label}</span>
          <strong class="mt-1 block text-lg">{value}</strong>
        </div>
      ))}
    </div>
  </section>

  <section id="hours" class="section-space bg-white">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[.95fr_1.05fr] lg:items-center">
        <div>
          <p class="eyebrow">OPENING HOURS</p>
          <h2 class="serif-tc mt-4 text-4xl font-black leading-tight text-night-950 sm:text-5xl">四維夜市營業時間：<br class="hidden sm:block" />每週日 {openingHours.opens}–{openingHours.closes}</h2>
          <p class="mt-6 max-w-xl leading-8 text-slate-600">
            四維夜市不是每天營業，只有週日晚上開市，常見時段約 {openingHours.opens}–{openingHours.closes}；建議 {openingHours.arrive} 抵達，攤位較齊全，也比較好安排停車。
          </p>
          <p id="sunday-countdown" class="mt-5 inline-flex items-center gap-2 rounded-full bg-rice-100 px-4 py-2 text-sm font-bold text-night-900" aria-live="polite">正在讀取台灣時間…</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/transport/#parking" class="inline-flex items-center gap-2 rounded-full bg-night-950 px-6 py-3.5 text-sm font-black text-white transition hover:-translate-y-0.5" data-ga-event="hours_parking">停車方式與交通 <span aria-hidden="true">→</span></a>
            <a href="/food/" class="inline-flex items-center gap-2 rounded-full border border-night-900/15 px-6 py-3.5 text-sm font-bold text-night-950 transition hover:border-market-500/40 hover:text-market-600" data-ga-event="hours_food">10 個必吃美食攤位</a>
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {[
            ['開市日', openingHours.dayLabel, '其他日子不營業'],
            ['常見時段', `${openingHours.opens}–${openingHours.closes}`, '各攤開收時間不同'],
            ['建議抵達', openingHours.arrive, '攤位齊全、好停車']
          ].map(([label, value, note]) => (
            <div class="rounded-3xl border border-night-900/10 bg-rice-50 p-6">
              <span class="block text-xs font-black tracking-[.16em] text-market-600">{label}</span>
              <strong class="mt-2 block text-2xl font-black text-night-950">{value}</strong>
              <span class="mt-2 block text-xs leading-6 text-slate-500">{note}</span>
            </div>
          ))}
        </div>
      </div>
      <p class="mt-8 rounded-2xl bg-rice-100 p-5 text-sm leading-7 text-night-900"><span class="font-black">提醒｜</span>{openingHours.note}</p>
    </div>
  </section>

  <section id="status" class="bg-night-950 pb-20 pt-10 text-white">
    <div class="container-site">
      <div class="grid overflow-hidden rounded-3xl border border-lantern-300/20 bg-night-900 lg:grid-cols-[1.2fr_.8fr]">
        <div class="p-7 sm:p-10">
          <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-lantern-300/25 bg-lantern-300/8 px-4 py-2 text-sm font-bold text-lantern-300">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2"><path d="M12 21s6-5.4 6-12A6 6 0 0 0 6 9c0 6.6 6 12 6 12Z"/><circle cx="12" cy="9" r="2"/></svg>
            目前位置提醒
          </div>
          <h2 class="serif-tc max-w-2xl text-3xl font-black leading-tight sm:text-4xl">四維夜市現在在「四維路底」</h2>
          <p class="mt-5 max-w-2xl leading-8 text-white/70">
            請導航至 <strong class="text-white">四維路底、TAITUNG 英文字母地標附近</strong>。若搜尋結果仍指向四維路一段，那是搬遷前的舊址；抵達前請以本頁 Google 地圖位置為準。
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={site.mapUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-lantern-400 px-6 py-3.5 text-sm font-black text-night-950 transition hover:-translate-y-0.5 hover:bg-lantern-300" data-ga-event="map_status">
              導航到四維夜市目前位置
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2"><path d="M5 12h14M14 7l5 5-5 5"/></svg>
            </a>
            <a href={site.officialNoticeUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full border border-white/20 px-6 py-3.5 text-sm font-bold text-white transition hover:border-white/40 hover:bg-white/5">查看當週公告</a>
          </div>
          <div class="mt-7 flex items-start gap-3 border-t border-white/10 pt-5 text-sm text-white/50">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 fill-none stroke-lantern-300 stroke-2"><path d="M3 11.5 12 4l9 7.5M5 10v9h14v-9"/></svg>
            <p><span class="font-bold text-white/75">附近地標</span><span class="mx-2 text-white/20">｜</span>台東海濱公園・TAITUNG 英文字母</p>
          </div>
          <p class="mt-4 flex items-start gap-2 border-l-2 border-lantern-300/40 pl-3 text-xs leading-6 text-white/45">
            <span class="shrink-0 font-bold text-white/65">地址提示</span>
            Google 地圖地點頁登錄地址仍為 {site.googleAddress}；實際攤區位於四維路底、TAITUNG 英文字母地標附近，請以本頁座標 {site.latitude}, {site.longitude} 導航。
          </p>
        </div>
        <div class="lantern-dots flex min-h-72 flex-col justify-center border-t border-white/10 bg-night-800 p-7 sm:p-10 lg:border-l lg:border-t-0">
          <p class="text-xs font-bold tracking-[.18em] text-lantern-300">依例行時間推估</p>
          <div id="market-status" class="mt-3 text-3xl font-black" aria-live="polite">正在讀取台灣時間…</div>
          <p id="market-status-note" class="mt-3 leading-7 text-white/65">實際是否開市仍受天候與現場安排影響。</p>
          <p id="taiwan-time" class="mt-6 text-sm text-white/40"></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space paper-grid">
    <div class="container-site">
      <div class="grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:items-center">
        <div>
          <p class="eyebrow">ABOUT 臺東市四維夜市</p>
          <h2 class="serif-tc mt-4 text-4xl font-black leading-tight text-night-950 sm:text-5xl">關於臺東市四維夜市：<br />台東人的週日晚餐</h2>
          <div class="prose-readable mt-7 space-y-5 text-slate-700">
            <p>歡迎來到 <strong>臺東市四維夜市</strong>（常用的簡稱就是「四維夜市」，英文 Siwei Night Market，也是本站域名 SiweiNightMarket.com 的由來）。它位於 <strong>臺灣臺東縣臺東市</strong>，是臺東市區週日晚間最主要的在地夜市，由小吃、遊戲與生活雜貨攤位組成。</p>
            <p class="rounded-xl bg-rice-100 px-4 py-3 text-sm font-bold text-night-900">四維夜市 → 臺東市 → 臺東縣 → 臺灣</p>
            <p>四維夜市屬於典型的臺灣流動夜市。週日傍晚，餐車、帳棚、遊戲攤與生活雜貨陸續就位，形成一晚限定的街區。</p>
            <p>這裡最值得體驗的不是只追一間名店，而是先吃一份主食、和同行者分炸物，再帶著飲料逛遊戲攤。節奏放慢一點，會比趕著打卡更像真正的四維夜市。</p>
          </div>
          <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-2">
            {['在地小吃', '鐵板牛排', '親子遊戲', '生活雜貨'].map((item, i) => (
              <div class="rounded-2xl border border-night-900/10 bg-white p-4 font-bold text-night-900 shadow-sm"><span class="mr-2 text-lantern-500">0{i + 1}</span>{item}</div>
            ))}
          </div>
        </div>
        <figure class="relative">
          <div class="absolute -left-4 -top-4 hidden size-28 rounded-full border-[18px] border-lantern-400/30 lg:block"></div>
          <img src="/images/siwei-night-market-grill.webp" alt="四維夜市舊場地烤物攤位與逛街人潮" width="1147" height="860" loading="lazy" class="relative aspect-[4/3] w-full rounded-[2rem] object-cover shadow-2xl shadow-night-950/15" />
          <figcaption class="mt-3 text-sm text-slate-500">四維夜市搬遷前的實景紀錄，呈現傳統流動夜市氛圍。</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <WeatherModule />

  <ReviewsSection />

  <section id="food" class="section-space overflow-hidden bg-rice-100">
    <div class="container-site">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">WHAT TO EAT</p>
          <h2 class="serif-tc mt-3 text-4xl font-black text-night-950 sm:text-5xl">2026 人氣美食線索</h2>
          <p class="mt-4 max-w-2xl leading-7 text-slate-600">以下整理自 2026 年夜市人氣票選名單，適合作為找攤方向；流動攤販不保證每週固定出攤，也不代表永久排名。</p>
        </div>
        <span class="w-fit rounded-full border border-market-500/20 bg-white px-4 py-2 text-sm font-bold text-market-600">10 個找攤方向</span>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {foods.map((food, index) => (
          <article class="group rounded-3xl border border-night-900/8 bg-white p-5 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-night-950/8">
            <div class="flex items-center justify-between">
              <span class="text-3xl font-black text-lantern-400/75">{String(index + 1).padStart(2, '0')}</span>
              <span class="rounded-full bg-rice-100 px-2.5 py-1 text-xs font-bold text-market-600">{food.type}</span>
            </div>
            <h3 class="mt-6 text-lg font-black text-night-950">{food.name}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{food.note}</p>
            <div class="mt-5 flex flex-wrap gap-2 border-t border-slate-100 pt-4 text-xs font-bold">
              <span class="rounded-full bg-night-950 px-2.5 py-1 text-white">{food.round}</span>
              <span class="rounded-full bg-rice-100 px-2.5 py-1 text-night-900">{food.bestFor}</span>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {visitSteps.map(({ step, title, copy }, index) => (
          <article class:list={['rounded-3xl p-7', index === 0 || index === 2 ? 'bg-night-900 text-white' : index === 1 ? 'bg-market-600 text-white' : 'bg-lantern-400 text-night-950']}>
            <span class:list={['text-sm font-black', index === 3 ? 'text-market-600' : 'text-lantern-300']}>{step}</span>
            <h3 class="mt-2 text-xl font-black">{title}</h3>
            <p class:list={['mt-3 text-sm leading-7', index === 3 ? 'text-night-950/70' : 'text-white/70']}>{copy}</p>
          </article>
        ))}
      </div>
      <div class="mt-8 text-center"><a href="/food/" class="inline-flex items-center gap-2 rounded-full border border-night-900/15 bg-white px-6 py-3 font-black text-night-950 transition hover:border-market-500/40 hover:text-market-600">查看完整美食指南 <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section-space bg-night-950 text-white">
    <div class="container-site grid gap-5 md:grid-cols-2">
      <figure class="group overflow-hidden rounded-[2rem] bg-night-900">
        <div class="overflow-hidden"><img src="/images/siwei-night-market-food.webp" alt="四維夜市舊場地烤玉米與小吃攤實景" width="1147" height="860" loading="lazy" class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-105" /></div>
        <figcaption class="p-6"><strong class="block text-xl">邊走邊吃的夜市節奏</strong><span class="mt-2 block text-sm text-white/50">舊場地實景紀錄，攤位與位置可能變動。</span></figcaption>
      </figure>
      <figure class="group overflow-hidden rounded-[2rem] bg-night-900 md:translate-y-12">
        <div class="overflow-hidden"><img src="/images/siwei-night-market-family-games.webp" alt="四維夜市舊場地親子遊戲攤實景" width="1147" height="860" loading="lazy" class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-105" /></div>
        <figcaption class="p-6"><strong class="block text-xl">吃完還能玩一輪</strong><span class="mt-2 block text-sm text-white/50">傳統遊戲是四維夜市的重要特色。</span></figcaption>
      </figure>
    </div>
  </section>

  <section id="transport" class="section-space bg-white">
    <div class="container-site">
      <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
        <div>
          <p class="eyebrow">GETTING THERE</p>
          <h2 class="serif-tc mt-3 text-4xl font-black text-night-950 sm:text-5xl">四維夜市在臺東市的位置與怎麼去</h2>
          <p class="mt-5 max-w-xl leading-8 text-slate-600">最重要的是不要只照舊文章的門牌走。直接以本頁座標或「四維路底 TAITUNG 字母地標」作為目的地；Google 地圖地點頁登錄地址為 {site.googleAddress}，僅供地址參照，實際攤區請比對座標。</p>
          <p class="mt-3 max-w-xl text-sm leading-7 text-slate-500">如需臺東縣／臺東市官方觀光、活動與交通資訊，請參考 <a href={site.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-market-600 hover:text-market-500" data-ga-event="govt_tourism">{site.govtTourismLabel}</a>。</p>

          <div class="mt-9 space-y-4">
