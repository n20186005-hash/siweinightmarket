---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { routePlans, site } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: site.url },
    { '@type': 'ListItem', position: 2, name: '周邊行程', item: `${site.url}/nearby/` }
  ]
};

const routeNotes = [
  ['輕鬆版', '步行量較少，適合帶孩子、長輩同行，或只想安排一個不趕路的週日下午。'],
  ['完整版', '把森林、海濱與夜市串在一起，適合第一次到台東市區、想一次感受自然與街區的人。'],
  ['雨天備案', '露天夜市與海邊都受天候影響，雨勢明顯時不要為了照表走完而勉強停留。']
];
---
<BaseLayout title="四維夜市周邊行程｜森林公園、海濱公園半日遊" description="把台東森林公園、台東海濱公園與週日四維夜市串成輕鬆版、完整版或雨天備案三種半日行程。">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="bg-night-950 py-16 text-white sm:py-20">
    <div class="container-site max-w-5xl">
      <Breadcrumbs dark items={[{ label: '周邊行程' }]} />
      <p class="mt-10 text-xs font-black tracking-[.18em] text-lantern-300">NEARBY ROUTES</p>
      <h1 class="serif-tc mt-3 max-w-4xl text-4xl font-black leading-tight sm:text-6xl">下午看森林和海，<br />傍晚再把胃口留給夜市</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-white/65">三個地點集中在台東市區，可依體力與天候選擇行程。時間是規劃範例，不代表場館或夜市的即時營業狀態。</p>
    </div>
  </section>

  <section class="section-space bg-rice-50">
    <div class="container-site grid gap-6 lg:grid-cols-2">
      <article class="overflow-hidden rounded-[2rem] bg-white shadow-sm">
        <img src="/images/taitung-forest-park.webp" alt="台東森林公園湖泊與自行車道" width="1350" height="1800" class="aspect-[16/10] w-full object-cover" />
        <div class="p-7">
          <p class="text-xs font-black tracking-[.16em] text-market-600">FOREST</p>
          <h2 class="mt-2 text-2xl font-black text-night-950">台東森林公園</h2>
          <p class="mt-4 leading-7 text-slate-600">下午以散步或自行車為主，不必一次走完整座園區。夏季注意補水，並為晚上的夜市保留體力。</p>
        </div>
      </article>
      <article class="overflow-hidden rounded-[2rem] bg-white shadow-sm">
        <img src="/images/taitung-seaside-park.webp" alt="台東海濱公園海岸景觀" width="1800" height="1350" class="aspect-[16/10] w-full object-cover" />
        <div class="p-7">
          <p class="text-xs font-black tracking-[.16em] text-market-600">SEASIDE</p>
          <h2 class="mt-2 text-2xl font-black text-night-950">台東海濱公園</h2>
          <p class="mt-4 leading-7 text-slate-600">傍晚看海、確認停車位置，再步行前往四維路底。沿海風勢較明顯，天候不穩時縮短停留。</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section-space bg-white">
    <div class="container-site">
      <div class="max-w-3xl">
        <p class="eyebrow">CHOOSE YOUR ROUTE</p>
        <h2 class="serif-tc mt-3 text-3xl font-black text-night-950 sm:text-5xl">依同行者和天氣，選一條就好</h2>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {routePlans.map((route, index) => (
          <article class:list={['overflow-hidden rounded-[2rem] border', index === 1 ? 'border-lantern-400 bg-night-950 text-white' : 'border-night-900/10 bg-rice-50 text-night-950']}>
            <div class="p-7">
              <p class:list={['text-xs font-black tracking-[.16em]', index === 1 ? 'text-lantern-300' : 'text-market-600']}>{route.audience}</p>
              <h3 class="mt-2 text-2xl font-black">{route.name}</h3>
              <p class:list={['mt-4 text-sm leading-7', index === 1 ? 'text-white/65' : 'text-slate-600']}>{routeNotes[index][1]}</p>
            </div>
            <ol class:list={['divide-y p-3', index === 1 ? 'divide-white/10' : 'divide-night-900/8']}>
              {route.stops.map(([time, stop], stopIndex) => (
                <li class="grid grid-cols-[4.5rem_1fr] gap-3 rounded-xl p-4">
                  <span class:list={['text-sm font-black', index === 1 ? 'text-lantern-300' : 'text-market-600']}>{time}</span>
                  <span class="font-bold">{stop}</span>
                  {stopIndex < route.stops.length - 1 && <span aria-hidden="true" class:list={['col-start-1 ml-2 h-4 border-l', index === 1 ? 'border-white/20' : 'border-night-900/15']}></span>}
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space bg-rice-100">
    <div class="container-site grid gap-8 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="eyebrow">TRIP CHECK</p>
        <h2 class="serif-tc mt-3 text-3xl font-black text-night-950">決定路線前看三件事</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {[
          ['天候', '海邊與夜市皆為戶外，先看降雨、風勢與體感溫度。'],
          ['體力', '森林公園範圍大，不必為了走完而壓縮晚餐時間。'],
          ['回程', '夜間交通選擇較少，先決定停車、叫車或接送方式。']
        ].map(([title, copy]) => (
          <article class="rounded-2xl bg-white p-5"><h3 class="font-black text-night-950">{title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{copy}</p></article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
