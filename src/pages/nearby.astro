---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { routePlans, site } from '../data/site';
import { attractions } from '../data/attractions';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${site.url}/nearby/#webpage`,
      url: `${site.url}/nearby/`,
      name: '台東四維夜市周邊景點｜森林公園、海濱公園順遊行程',
      description: '台東四維夜市周邊順遊：把台東森林公園、台東海濱公園與週日夜市串成輕鬆版、完整版與雨天備案三種半日行程，附時間安排與交通提醒。',
      inLanguage: 'zh-Hant',
      isPartOf: { '@type': 'WebSite', '@id': `${site.url}/#website` }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: site.url },
        { '@type': 'ListItem', position: 2, name: '周邊行程', item: `${site.url}/nearby/` }
      ]
    }
  ]
};

const routeNotes = [
  ['輕鬆版', '步行量較少，適合帶孩子、長輩同行，或只想安排一個不趕路的週日下午。'],
  ['完整版', '把森林、海濱與夜市串在一起，適合第一次到台東市區、想一次感受自然與街區的人。'],
  ['雨天備案', '露天夜市與海邊都受天候影響，雨勢明顯時不要為了照表走完而勉強停留。']
];
---
<BaseLayout title="台東四維夜市周邊景點｜森林公園、海濱公園順遊行程" description="台東四維夜市周邊順遊：把台東森林公園、台東海濱公園與週日夜市串成輕鬆版、完整版與雨天備案三種半日行程，附時間安排與交通提醒。">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="bg-night-950 py-16 text-white sm:py-20">
    <div class="container-site max-w-5xl">
      <Breadcrumbs dark items={[{ label: '周邊行程' }]} />
      <p class="mt-10 text-xs font-black tracking-[.18em] text-lantern-300">NEARBY ROUTES</p>
      <h1 class="serif-tc mt-3 max-w-4xl text-4xl font-black leading-tight sm:text-6xl">下午看森林和海，<br />傍晚再把胃口留給夜市</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-white/65">三個地點集中在台東市區，可依體力與天候選擇行程。時間是規劃範例，不代表場館或夜市的即時營業狀態。</p>
    </div>
  </section>

  <section id="sunday-plan" class="section-space bg-rice-50"><div class="container-site">
    <p class="eyebrow">SUNDAY AFTERNOON TO NIGHT</p><h2 class="serif-tc mt-3 text-3xl font-black text-night-950 sm:text-5xl">台東市區週日半日遊：森林、海岸、夜市</h2>
    <p class="mt-5 max-w-3xl leading-8 text-slate-600">這份安排專門給週日下午抵達臺東市區、晚上想逛四維夜市的人。時間是可調整的行程建議，並非公園或夜市的即時開放保證。</p>
    <ol class="mt-9 grid gap-5 md:grid-cols-4">
      <li class="rounded-3xl bg-white p-6"><span class="font-black text-market-600">15:30 · 林蔭散步</span><h3 class="mt-3 text-xl font-black"><a href="/attractions/taitung-forest-park/" class="hover:text-market-600">臺東森林公園 →</a></h3><p class="mt-3 leading-7 text-slate-600">選一段林道或一處湖景；夏天補水，別為了走遍園區壓縮後面時間。</p></li>
      <li class="rounded-3xl bg-white p-6"><span class="font-black text-market-600">17:00 · 傍晚看海</span><h3 class="mt-3 text-xl font-black"><a href="/attractions/taitung-seaside-park/" class="hover:text-market-600">臺東海濱公園 →</a></h3><p class="mt-3 leading-7 text-slate-600">順著海岸散步、看天色；強風大雨時縮短停留，不靠近危險岸際。</p></li>
      <li class="rounded-3xl bg-white p-6"><span class="font-black text-market-600">18:00 · 先確認入口</span><h3 class="mt-3 text-xl font-black"><a href="/relocation/" class="hover:text-market-600">四維路底導航 →</a></h3><p class="mt-3 leading-7 text-slate-600">比對攤區公告與地標，先完成合法停車或接送安排，再步行進場。</p></li>
      <li class="rounded-3xl bg-white p-6"><span class="font-black text-market-600">18:30–20:00 · 晚餐</span><h3 class="mt-3 text-xl font-black"><a href="/food/" class="hover:text-market-600">四維夜市必吃指南 →</a></h3><p class="mt-3 leading-7 text-slate-600">先主食後炸物甜點，同行者共享幾樣即可；保留返程時間。</p></li>
    </ol>
    <div class="mt-7 grid gap-5 md:grid-cols-2"><article class="rounded-3xl bg-white p-7"><h3 class="text-xl font-black">帶小孩或長輩</h3><p class="mt-3 leading-7 text-slate-600">把森林公園縮短為 30–45 分鐘，優先安排一處能坐下休息的景觀點；夜市人多時先約定集合位置。</p></article><article class="rounded-3xl bg-white p-7"><h3 class="text-xl font-black">下雨或不是週日</h3><p class="mt-3 leading-7 text-slate-600">雨大時不勉強海岸行程；若是週四至週六，可另外查詢<a href="/taitung-night-markets/" class="text-market-600 underline">正氣路臺東觀光夜市</a>，但不要把不同夜市當成同一個地點。</p></article></div>
  </div></section>

  <section class="section-space bg-rice-50">
    <div class="container-site grid gap-6 lg:grid-cols-2">
      <article class="overflow-hidden rounded-[2rem] bg-white shadow-sm">
        <img src="/images/taitung-forest-park.webp" alt="台東森林公園湖泊與自行車道" width="1350" height="1800" class="aspect-[16/10] w-full object-cover" />
        <div class="p-7">
          <p class="text-xs font-black tracking-[.16em] text-market-600">FOREST</p>
          <h2 class="mt-2 text-2xl font-black text-night-950"><a class="hover:text-market-600" href="/attractions/taitung-forest-park/">台東森林公園 →</a></h2>
          <p class="mt-4 leading-7 text-slate-600">下午以散步或自行車為主，不必一次走完整座園區。夏季注意補水，並為晚上的夜市保留體力。</p>
        </div>
      </article>
      <article class="overflow-hidden rounded-[2rem] bg-white shadow-sm">
        <img src="/images/taitung-seaside-park.webp" alt="台東海濱公園海岸景觀" width="1800" height="1350" class="aspect-[16/10] w-full object-cover" />
        <div class="p-7">
          <p class="text-xs font-black tracking-[.16em] text-market-600">SEASIDE</p>
          <h2 class="mt-2 text-2xl font-black text-night-950"><a class="hover:text-market-600" href="/attractions/taitung-seaside-park/">台東海濱公園 →</a></h2>
          <p class="mt-4 leading-7 text-slate-600">傍晚看海、確認停車位置，再步行前往四維路底。沿海風勢較明顯，天候不穩時縮短停留。</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section-space bg-white"><div class="container-site">
    <p class="eyebrow">ATTRACTION GUIDES</p><h2 class="serif-tc mt-3 text-3xl font-black text-night-950">周邊景點詳情與獨立導航</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-2">{attractions.map((item) => <a href={`/attractions/${item.slug}/`} class="overflow-hidden rounded-3xl border border-slate-200 hover:border-market-600"><img src={item.image} alt={item.imageAlt} width="640" height="427" loading="lazy" class="aspect-[16/8] w-full object-cover"/><div class="p-6"><h3 class="text-xl font-black text-night-950">{item.name}</h3><p class="mt-3 leading-7 text-slate-600">{item.lead}</p><span class="mt-3 inline-block font-black text-market-600">閱讀景點指南 →</span></div></a>)}</div>
  </div></section>

  <section class="section-space bg-white">
    <div class="container-site">
      <div class="max-w-3xl">
        <p class="eyebrow">CHOOSE YOUR ROUTE</p>
        <h2 class="serif-tc mt-3 text-3xl font-black text-night-950 sm:text-5xl">依同行者和天氣，選一條就好</h2>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {routePlans.map((route, index) => (
          <article class:list={['overflow-hidden rounded-[2rem] border', index === 1 ? 'border-lantern-400 bg-night-950 text-white' : 'border-night-900/10 bg-rice-50 text-night-950']}>
            <div class="p-7">
              <p class:list={['text-xs font-black tracking-[.16em]', index === 1 ? 'text-lantern-300' : 'text-market-600']}>{route.audience}</p>
              <h3 class="mt-2 text-2xl font-black">{route.name}</h3>
              <p class:list={['mt-4 text-sm leading-7', index === 1 ? 'text-white/65' : 'text-slate-600']}>{routeNotes[index][1]}</p>
            </div>
            <ol class:list={['divide-y p-3', index === 1 ? 'divide-white/10' : 'divide-night-900/8']}>
              {route.stops.map(([time, stop], stopIndex) => (
                <li class="grid grid-cols-[4.5rem_1fr] gap-3 rounded-xl p-4">
                  <span class:list={['text-sm font-black', index === 1 ? 'text-lantern-300' : 'text-market-600']}>{time}</span>
                  <span class="font-bold">{stop}</span>
                  {stopIndex < route.stops.length - 1 && <span aria-hidden="true" class:list={['col-start-1 ml-2 h-4 border-l', index === 1 ? 'border-white/20' : 'border-night-900/15']}></span>}
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space bg-rice-100">
    <div class="container-site grid gap-8 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="eyebrow">TRIP CHECK</p>
        <h2 class="serif-tc mt-3 text-3xl font-black text-night-950">決定路線前看三件事</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {[
          ['天候', '海邊與夜市皆為戶外，先看降雨、風勢與體感溫度。'],
          ['體力', '森林公園範圍大，不必為了走完而壓縮晚餐時間。'],
          ['回程', '夜間交通選擇較少，先決定停車、叫車或接送方式。']
        ].map(([title, copy]) => (
          <article class="rounded-2xl bg-white p-5"><h3 class="font-black text-night-950">{title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{copy}</p></article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
